# ── EvidenceEU Frontend — Environment Variables ───────────────────────────────
# Copy to frontend/.env.local for local development.
# NEVER commit the actual .env.local file.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supported languages (comma-separated ISO 639-1 codes)
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,de,fr

# Sentry (error monitoring — unset → no-op)
NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<org_id>.ingest.sentry.io/<project_id>

# Datadog RUM + Logs (browser-safe — client token ≠ API key)
NEXT_PUBLIC_DATADOG_APPLICATION_ID=your-datadog-app-id
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=your-datadog-client-token

# New Relic Browser Agent (browser-safe — browser license key ≠ API key)
NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=your-nr-account-id
NEXT_PUBLIC_NEW_RELIC_APPLICATION_ID=your-nr-app-id
NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=your-nr-browser-license-key
NEXT_PUBLIC_NEW_RELIC_AGENT_ID=your-nr-agent-id
NEXT_PUBLIC_NEW_RELIC_TRUST_KEY=your-nr-trust-key

# PostHog Product Analytics (browser-safe — project token ≠ API key)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags (mirror backend flags for conditional UI rendering)
NEXT_PUBLIC_ENABLE_MATRIX_EXCHANGE=false   # Sprint 3
NEXT_PUBLIC_ENABLE_HEALTHCARE_PHASE2=false # Phase 2 — never true during capstone
