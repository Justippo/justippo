{
  "name": "evidence-eu-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "NEXT_EXPORT=false next dev",
    "build": "next build",
    "build:export": "NEXT_EXPORT=true next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-ts",
    "format": "prettier --write src",
    "test:storybook": "test-storybook -c .storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:browserstack": "browserstack-node-sdk playwright test tests/e2e/specs/browserstack-smoke.spec.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --webpack-stats-json",
    "test-storybook": "test-storybook"
  },
  "dependencies": {
    "@datadog/browser-logs": "^7.3.0",
    "@datadog/browser-rum": "^7.3.0",
    "@evidenceeu/shared": "workspace:*",
    "@sentry/browser": "^10.58.0",
    "@sentry/nextjs": "^10.59.0",
    "@tailwindcss/typography": "^0.5.13",
    "@tolgee/react": "^7.1.1",
    "@tolgee/web": "^7.1.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.0",
    "posthog-js": "^1.404.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@hey-api/openapi-ts": "^0.85.1",
    "@playwright/test": "^1.44.0",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/builder-webpack5": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "1",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "autoprefixer": "^10.4.19",
    "browserstack-node-sdk": "^1.63.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "schema-utils": "^4.3.3",
    "serve": "^14.2.6",
    "storybook": "8.6.14",
    "vite": "^6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.0",
    "wait-on": "^9.0.10"
  },
  "license": "MIT"
}
