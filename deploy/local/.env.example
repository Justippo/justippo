# Local Services Configuration - Example
# 
# Copy this file to .env and fill in your actual values
# This file is committed to the repository for reference

# REQUIRED: Mistral API Key for Hindsight
# Get your key from: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your-mistral-api-key-here

# REQUIRED: Cloudflare AI Gateway for BabelDOC
# Get your account ID from Cloudflare Dashboard
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# REQUIRED: Cloudflare AI Gateway API Token
# Create a token in Cloudflare AI Gateway settings
CLOUDFLARE_AI_GATEWAY_TOKEN=your-cloudflare-ai-gateway-token

# REQUIRED: BabelDOC Authentication Token
# Generate a random secret (e.g., openssl rand -hex 32)
BABELDOC_AUTH_TOKEN=generate-a-random-secret-here

# Optional: BabelDOC Configuration
# BABELDOC_OPENAI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# BABELDOC_MAX_PDF_BYTES=10485760
# BABELDOC_TIMEOUT_SECONDS=120
