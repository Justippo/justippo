# Wrangler build cache
.wrangler/
backend/.wrangler/
frontend/.wrangler/

# Python Worker bundled modules (generated by pywrangler)
# IMPORTANT: This MUST stay in ROOT .gitignore, NOT backend/.gitignore.
# Wrangler reads .gitignore from the Worker's directory (backend/). If
# python_modules/ appears in backend/.gitignore, wrangler excludes it from
# the upload, causing ModuleNotFoundError: No module named 'fastapi' (502).
backend/python_modules/
backend/.venv-workers/

# uv lockfile (not needed in CI — pyproject.toml is the source of truth)
backend/uv.lock

# Vercel deploy cache
frontend/.vercel/

# Next.js generated type declarations
frontend/next-env.d.ts

