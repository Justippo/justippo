*.log

# Root artifacts (root package.json is now tracked for Turborepo workspaces)
/node_modules/
/package-lock.json
**/package-lock.json
**/.turbo/

# Experiment outputs (generated data, NOT source code)
experiments/**/optimized_prompt.json

# Performance test artifacts
k6_results.json
assets/media_assets.json

# Demo artifacts (binary/large — not submitted via git)
docs/demo/screenshots/
docs/demo/recordings/
