# ── EvidenceEU Backend — Environment Variables ────────────────────────────────
# Copy to backend/.env for local development.
# NEVER commit the actual .env file.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-secret  # Used for JWT signing
APP_DEBUG=true
APP_LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./evidence_eu.db   # Local: SQLite; Prod: Cloudflare D1 via REST
CF_D1_DATABASE_ID=your-d1-database-id               # Cloudflare D1 database ID (production)

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id     # Cloudflare Account ID for wrangler/scripts
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token       # Cloudflare API Token for wrangler/scripts
CLOUDFLARE_GATEWAY_ID=evidence-eu-gateway            # Cloudflare AI Gateway Slug
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
CF_AI_GATEWAY_ID=evidence-eu-gateway        # Slug for your Cloudflare AI Gateway (legacy)
CF_VECTORIZE_INDEX_NAME=evidence-eu-docs    # Cloudflare Vectorize index name

# ── RAG / Vector DB ───────────────────────────────────────────────────────────
VECTOR_DB_PROVIDER=chromadb                  # chromadb (local dev) | cloudflare (production)
CHROMADB_URL=http://chromadb:8500
HINDSIGHT_API_URL=http://localhost:8600      # Self-hosted Vectorize Hindsight (Sprint 1)
HINDSIGHT_BANK_ID=evidence-eu-docs           # Hindsight memory bank (namespace) for documents
HINDSIGHT_ACCESS_KEY=                        # Optional bearer token protecting the Hindsight API
HINDSIGHT_RECALL_BUDGET=mid                  # low | mid | high search depth
HINDSIGHT_RECALL_MAX_TOKENS=4096             # Maximum recall response tokens

# ── Hindsight Docker LLM backend ──────────────────────────────────────────────
# Hindsight needs its OWN LLM key for internal fact extraction (separate from app LLM).
# Groq is recommended (fast, generous free tier).
HINDSIGHT_LLM_PROVIDER=groq                  # groq | openai | openrouter
HINDSIGHT_LLM_API_KEY=gsk_...               # LLM API key passed into the Hindsight container

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_PROVIDER=mistral                         # mistral | tesseract
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_OCR_ENABLED=true                     # false → skip Mistral, use Tesseract directly
TESSERACT_LANG=eng                           # Tesseract language pack(s), e.g. eng+deu+fra

# ── Azure Document Intelligence ─────────────────────────────────────────────
# Keep disabled until EU-region/privacy review is complete. Endpoint and key
# are server-side values; never expose the key through NEXT_PUBLIC_* variables.
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_TIER=F0
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_S=30
AZURE_DOCUMENT_INTELLIGENCE_POLL_INTERVAL_S=1
AZURE_DOCUMENT_INTELLIGENCE_MAX_POLLS=120

# ── Document Classification ──────────────────────────────────────────────────
PROPELLA_ENABLED=true                        # false → use local language fallback only
PROPELLA_BASE_URL=http://propella:8700        # SGLang propella-1 sidecar OpenAI-compatible URL

# ── Translation ───────────────────────────────────────────────────────────────
TRANSLATION_PROVIDER=babeldoc                # babeldoc | deepl | llm
# Set to true to run real m2m100 model integration tests.
# Requires CF Workers AI credentials. Adds ~30s to test run.
TRANSLATION_INTEGRATION_TESTS=false
# Delay between real-model test calls to avoid CF Workers AI rate limits.
TRANSLATION_TEST_DELAY_S=0.5

# BabelDOC uses an OpenAI-compatible Cloudflare AI Gateway endpoint. These are
# consumed only by the isolated sidecar; keep the API key server-side.
BABELDOC_OPENAI_BASE_URL=
BABELDOC_OPENAI_API_KEY=
BABELDOC_OPENAI_MODEL=


# ── Matrix Protocol (Sprint 3) ────────────────────────────────────────────────
MATRIX_HOMESERVER_URL=https://synapse.evidenceeu.eu.mihai.codes    # Self-hosted Synapse (or matrix.org)
MATRIX_ACCESS_TOKEN=your-matrix-token
MATRIX_ROOM_PREFIX=evidence-eu

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_MATRIX_EXCHANGE=false                 # Sprint 3 — secure cross-border document exchange
ENABLE_HEALTHCARE_PHASE2=false               # Phase 2 — never true during capstone
ENABLE_FHIR_PARSING=false                    # Phase 2 — depends on ENABLE_HEALTHCARE_PHASE2

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://<key>@o<org_id>.ingest.sentry.io/<project_id>   # Unset → no-op
SENTRY_AUTH_TOKEN=your-sentry-auth-token     # For sourcemap upload in CI
SENTRY_ORG=your-sentry-org                   # Sentry org slug (for withSentryConfig)
SENTRY_PROJECT=evidence-eu                   # Sentry project slug

# ── Datadog ───────────────────────────────────────────────────────────────────
# SERVER-ONLY — never expose to browser. Used for custom metrics via httpx.
DATADOG_API_KEY=your-datadog-api-key         # Unset → no-op (graceful degradation)

# ── GDPR / Data Residency ─────────────────────────────────────────────────────
DATA_RESIDENCY_REGION=EU                     # EU | DE | FR — controls data routing
GDPR_CONSENT_REQUIRED=true
AUDIT_LOG_ENABLED=true

# ── Figma (MCP Server) ────────────────────────────────────────────────────────
FIGMA_API_TOKEN=your-figma-personal-access-token  # Used by figma-developer-mcp in opencode.json
