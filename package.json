{
  "name": "evidence-eu",
  "private": true,
  "workspaces": [
    "frontend",
    "worker",
    "packages/*",
    "apps/mobile"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "mobile:dev": "turbo run dev --filter=@evidenceeu/mobile",
    "mobile:build": "turbo run build --filter=@evidenceeu/mobile"
  },
  "devDependencies": {
    "@types/react": "19",
    "@types/react-dom": "19",
    "husky": "^9.1.7",
    "turbo": "^2.5.0"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@tolgee/core": "^7.1.1",
    "@tolgee/react": "^7.1.1",
    "@tolgee/web": "^7.1.1"
  }
}
