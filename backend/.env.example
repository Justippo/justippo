# ── EvidenceEU Backend — Environment Variables ────────────────────────────────
# Copy to backend/.env for local development.
# NEVER commit the actual .env file.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-secret
APP_DEBUG=true
APP_LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./evidence_eu.db   # Local: SQLite; Prod: Cloudflare D1 via REST
CF_D1_DATABASE_ID=your-d1-database-id               # Cloudflare D1 database ID (production)

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id     # Cloudflare Account ID for wrangler/scripts
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token       # Cloudflare API Token for wrangler/scripts
CLOUDFLARE_GATEWAY_ID=evidence-eu-gateway            # Cloudflare AI Gateway Slug
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
CF_AI_GATEWAY_ID=evidence-eu-gateway        # Slug for your Cloudflare AI Gateway (legacy)
CF_AIG_AUTHORIZATION=your-cf-aig-token
CF_WORKERS_AI_API_TOKEN=your-cf-workers-ai-token  # Workers AI API token for m2m100 translation
CF_VECTORIZE_INDEX_NAME=evidence-eu-docs    # Cloudflare Vectorize index name

# ── RAG / Vector DB ───────────────────────────────────────────────────────────
VECTOR_DB_PROVIDER=chromadb                  # chromadb (local dev) | cloudflare (production)
CHROMADB_URL=http://chromadb:8500
HINDSIGHT_API_URL=http://localhost:8600      # Self-hosted Vectorize Hindsight (Sprint 1)
HINDSIGHT_BANK_ID=evidence-eu-docs           # Hindsight memory bank (namespace) for documents
HINDSIGHT_ACCESS_KEY=                        # Optional bearer token protecting the Hindsight API
HINDSIGHT_RECALL_BUDGET=mid                  # low | mid | high search depth
HINDSIGHT_RECALL_MAX_TOKENS=4096             # Maximum recall response tokens

# ── Hindsight Docker LLM backend ──────────────────────────────────────────────
# Hindsight needs its OWN LLM key for internal fact extraction (separate from app LLM).
# Groq is recommended (fast, generous free tier).
HINDSIGHT_LLM_PROVIDER=groq                  # groq | openai | openrouter
HINDSIGHT_LLM_API_KEY=REDACTED_ROTATED_KEY

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── SSE Streaming ────────────────────────────────────────────────────────────
SSE_CHUNK_DELAY_MS=0                         # Delay (ms) between SSE yields; 0 = disabled

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_PROVIDER=mistral                         # mistral | tesseract
MISTRAL_API_KEY=your-mistral-api-key

# ── Azure Document Intelligence ─────────────────────────────────────────────
# Disabled by default. Configure only with an approved European resource.
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_TIER=F0
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-layout
AZURE_DOCUMENT_INTELLIGENCE_TIMEOUT_S=30
AZURE_DOCUMENT_INTELLIGENCE_POLL_INTERVAL_S=1
AZURE_DOCUMENT_INTELLIGENCE_MAX_POLLS=120

# ── Reducto (ADR-009: public corpus only — seed_documents.py) ─────────────────
ENABLE_REDUCTO=false
REDUCTO_API_KEY=your-reducto-api-key

# ── Not Diamond Model Routing (Sprint 3, opt-in) ──────────────────────────────
# Layered on top of CF AI Gateway + BAML. Picks the best LLM per task.
# No-op when NOT_DIAMOND_ENABLED=false (default) — CI passes without a key.
# GDPR: only metadata signals are sent to Not Diamond (no document content).
NOT_DIAMOND_ENABLED=false                    # true → enable routing; false → direct call to CF_WORKERS_AI_TRANSLATION_MODEL
NOT_DIAMOND_API_KEY=your-not-diamond-key     # Bearer token. Empty + NOT_DIAMOND_ENABLED=false → no-op.
NOT_DIAMOND_BASE_URL=https://api.notdiamond.ai/v2  # Override only for self-hosted or staging.
NOT_DIAMOND_DEFAULT_MODEL=@cf/meta/m2m100-1.2b # Fallback when routing is disabled / times out / fails.
NOT_DIAMOND_TIMEOUT_MS=800
NOT_DIAMOND_PREFERENCE_ID=  # Custom router ID from trainCustomRouter (empty = use pre-trained)

# ── Translation ───────────────────────────────────────────────────────────────
TRANSLATION_PROVIDER=babeldoc                # babeldoc | deepl | llm

# ── BAML Glossary (ADR-010) ───────────────────────────────────────────────────
# Primary: CF AI Gateway /compat (Workers AI free tier). Falls back to /openai (BYOK).
# Model override (optional): BAML_GLOSSARY_MODEL_OVERRIDE=openai/gpt-4o
BAML_GLOSSARY_MODEL_OVERRIDE=                # Set to override the default free-tier model
# Fallback: requires OpenAI BYOK configured in CF AI Gateway dashboard.
# OPENAI_API_KEY is stored in Gateway Secrets; CF_AIG_AUTHORIZATION authenticates to gateway.

# ── Matrix Protocol (Sprint 3) ────────────────────────────────────────────────
MATRIX_HOMESERVER_URL=https://synapse.evidenceeu.eu.mihai.codes    # Self-hosted Synapse (or matrix.org)
MATRIX_ACCESS_TOKEN=your-matrix-token
MATRIX_DEVICE_ID=your-matrix-device-id
MATRIX_ROOM_PREFIX=evidence-eu

# ── BabelDOC Sidecar ──────────────────────────────────────────────────────────
# BabelDOC sidecar — post-capstone community edition path.
# Requires separate Docker runtime. See ADR-012.
BABELDOC_SIDECAR_URL=                        # e.g. http://localhost:8700 (Docker sidecar)
BABELDOC_ENABLED=false                       # Enable layout-preserving translation via sidecar
# Production workers receive BABELDOC_SIDECAR_URL as a secret via CI.
# Runtime translation backend consumed inside the isolated sidecar.
BABELDOC_OPENAI_BASE_URL=                    # Cloudflare AI Gateway /compat endpoint
BABELDOC_OPENAI_API_KEY=                     # Server-side gateway token
BABELDOC_OPENAI_MODEL=                       # OpenAI-compatible model identifier

# ── Demo Mode ─────────────────────────────────────────────────────────────
# Activates DemoWarmupMiddleware (cold-start headers) + translation truncation.
DEMO_MODE=false
# Max characters per page sent to m2m100 in demo mode. 0 = no limit.
DEMO_MAX_CHARS=2000

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_MATRIX_EXCHANGE=false                 # Sprint 3 — secure cross-border document exchange
ENABLE_HEALTHCARE_PHASE2=false               # Phase 2 — never true during capstone
ENABLE_FHIR_PARSING=false                    # Phase 2 — depends on ENABLE_HEALTHCARE_PHASE2

# ── GDPR / Data Residency ─────────────────────────────────────────────────────
DATA_RESIDENCY_REGION=EU                     # EU | DE | FR — controls data routing
GDPR_CONSENT_REQUIRED=true
AUDIT_LOG_ENABLED=true

# ── RAG Answer Generation (Apertus 8B via Public AI) ─────────────────────────
# Swiss sovereign LLM (Apache 2.0) for grounded RAG answers (ADR-014 candidate).
# Two routes, resolved in priority order (URLs centralized in gateway.py):
#   1. PUBLICAI_API_KEY → DIRECT Public AI platform (api.publicai.co). PREFERRED:
#      genuinely free sovereign utility, no HuggingFace monthly-credit metering.
#   2. HF_API_TOKEN     → HF Inference Providers router (:publicai suffix). Fallback;
#      HF meters this against the account's monthly included credits (402 when out).
# No-op contract: if BOTH are empty, answer generation is skipped (chunks only).
PUBLICAI_API_KEY=                            # Public AI key (SSO: https://platform.publicai.co/settings/api-keys)
HF_API_TOKEN=                                # HuggingFace read token (https://huggingface.co/settings/tokens)
RAG_LLM_MODEL=swiss-ai/Apertus-8B-Instruct-2509
RAG_LLM_MAX_TOKENS=512
RAG_LLM_TIMEOUT_S=30
# ── Laminar (LLM Observability) ───────────────────────────────────────────────
# Custom OTLP/HTTP/json forwarder — no lmnr SDK (Pyodide-incompatible, see
# app/integrations/laminar.py). No-op unless LMNR_ENABLED=true AND the key is set.
LMNR_PROJECT_API_KEY= # Get from https://laminar.sh project settings
LMNR_ENABLED=false
LMNR_ENDPOINT=https://api.lmnr.ai:443/v1/traces
LMNR_SEND_PROMPT_CONTENT=false # GDPR: keep false in production — never send document/query text
LMNR_SAMPLE_RATE=0.1
LMNR_SERVICE_NAME=evidence-eu-backend

# ── PostHog (Product Analytics) ───────────────────────────────────────────────
# Custom direct-HTTP /capture via http_forwarder.py — no posthog-python SDK
# (threading incompatible with Pyodide, see app/integrations/posthog.py).
# No-op unless POSTHOG_PROJECT_TOKEN is set.
POSTHOG_PROJECT_TOKEN=your-posthog-project-token
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_DISABLED=false

# ── Langfuse (LLM Call Quality Observability) ────────────────────────────────
# Custom OTLP/HTTP/json dispatch with Basic Auth — no langfuse SDK
# (opentelemetry-sdk uses threading, non-functional in Pyodide/WASM).
# No-op unless LANGFUSE_ENABLED=true AND both keys are set.
LANGFUSE_PUBLIC_KEY= # pk-lf-... from https://cloud.langfuse.com project settings
LANGFUSE_SECRET_KEY= # sk-lf-... from https://cloud.langfuse.com project settings
LANGFUSE_ENABLED=false
LANGFUSE_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
LANGFUSE_SEND_PROMPT_CONTENT=false # GDPR: keep false in production
LANGFUSE_SAMPLE_RATE=0.1
LANGFUSE_SERVICE_NAME=evidence-eu-backend
