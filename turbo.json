{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**", "storybook-static/**"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SUPPORTED_LANGUAGES",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_DATADOG_APPLICATION_ID",
        "NEXT_PUBLIC_DATADOG_CLIENT_TOKEN",
        "NEXT_PUBLIC_NEW_RELIC_ENABLED",
        "NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID",
        "NEXT_PUBLIC_NEW_RELIC_APPLICATION_ID",
        "NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY",
        "NEXT_PUBLIC_NEW_RELIC_AGENT_ID",
        "NEXT_PUBLIC_NEW_RELIC_TRUST_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "test": {
      "outputs": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.test.*", "src/**/*.spec.*", "vitest.config.ts", "src/test-setup.ts"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", ".eslintrc.*", "eslint.config.*"]
    },
    "format": {
      "outputs": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.css"]
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"],
      "inputs": ["src/**/*.stories.*", ".storybook/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": [],
      "inputs": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "mobile:dev": {
      "cache": false,
      "persistent": true
    },
    "mobile:build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
